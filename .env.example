# Bitnexel — client-side (public) environment variables.
# NEXT_PUBLIC_* values are inlined at build time for the static export,
# so they must not contain secrets. Anything secret belongs in the
# Cloudflare Worker (wrangler secret), never here.

# Lead intake endpoint (Cloudflare Worker). Leave unset to use the built-in
# default (https://bitnexel-leads.aanandab44.workers.dev/api/leads).
NEXT_PUBLIC_LEAD_ENDPOINT="https://bitnexel-leads.aanandab44.workers.dev/api/leads"
